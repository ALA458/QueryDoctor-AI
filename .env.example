# Copia este archivo a .env si quieres cambiar los valores por defecto.
# NUNCA pongas contraseñas aquí: van en secrets/ (ver abajo).

POSTGRES_DB=querydoctor
POSTGRES_USER=querydoctor

# Secretos requeridos (archivos de una línea, sin salto final, codificación ASCII):
#   secrets/postgres_password.txt
#   secrets/mssql_sa_password.txt   (mín. 8 caracteres: mayúsculas, minúsculas, números y símbolos)
#   secrets/initial_dba_password.txt (contraseña TEMPORAL del primer DBA, usuario "dba"; mín. 12 caracteres con
#                                     mayúscula, minúscula, número y símbolo; se obliga a cambiarla al primer ingreso)

# Aplica migraciones al arrancar la API (true en desarrollo, false en producción).
MIGRATE_ON_STARTUP=true

# Servicio de IA (S1-18, ADR-10):
# Perfiles: openrouter_free | openrouter_paid | gemini_free | ollama_local | mock
LLM_PROFILE=openrouter_free
# Obligatorio en dev/lab si se usa openrouter_free o gemini_free (bloqueado en prod por candado)
ALLOW_DATA_SHARING_PROVIDER=true
OPENROUTER_API_KEY=
