<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4315.2"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH TARGET_NATIONS AS (&#xa;    SELECT -- QD-TPCH:Q07:&#xa;        N_NATIONKEY,&#xa;        N_NAME&#xa;    FROM dbo.NATION&#xa;    WHERE N_NAME IN (&apos;FRANCE&apos;, &apos;GERMANY&apos;)&#xa;)&#xa;SELECT&#xa;    SUPP_NATION,&#xa;    CUST_NATION,&#xa;    L_YEAR,&#xa;    SUM(VOLUME) AS REVENUE&#xa;FROM (&#xa;    SELECT&#xa;        N1.N_NAME AS SUPP_NATION,&#xa;        N2.N_NAME AS CUST_NATION,&#xa;        YEAR(L.L_SHIPDATE) AS L_YEAR,&#xa;        L.L_EXTENDEDPRICE * (1 - L.L_DISCOUNT) AS VOLUME&#xa;    FROM dbo.SUPPLIER S&#xa;    JOIN dbo.LINEITEM L ON S.S_SUPPKEY = L.L_SUPPKEY&#xa;    JOIN dbo.ORDERS O ON O.O_ORDERKEY = L.L_ORDERKEY&#xa;    JOIN dbo.CUSTOMER C ON C.C_CUSTKEY = O.O_CUSTKEY&#xa;    JOIN TARGET_NATIONS N1 ON S.S_NATIONKEY = N1.N_NATIONKEY&#xa;    JOIN TARGET_NATIONS N2 ON C.C_NATIONKEY = N2.N_NATIONKEY&#xa;    WHERE N1.N_NATIONKEY &lt;&gt; N2.N_NATIONKEY&#xa;      AND L.L_SHIPDATE BETWEEN CAST(&apos;1995-01-01&apos; AS date) AND CAST(&apos;1996-12-31&apos; AS date)&#xa;) AS SHIPPING&#xa;GROUP BY SUPP_NATION, CUST_NATION, L_YEAR&#xa;ORDER BY SUPP_NATION ASC, CUST_NATION ASC, L_YEAR ASC" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x0900F04AEBB213F2B2658A6654685A16EEF30000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="false" StatementSubTreeCost="8.43776" StatementEstRows="6.62798" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x0188ADA2659A4715" QueryPlanHash="0x0665A323F5B1DA84" StatementOptmEarlyAbortReason="TimeOut" CardinalityEstimationModelVersion="160" BatchModeOnRowStoreUsed="true"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan CachedPlanSize="256" CompileTime="43" CompileCPU="43" CompileMemory="3520"><MissingIndexes><MissingIndexGroup Impact="81.1485"><MissingIndex Database="[QD_TPCH]" Schema="[dbo]" Table="[LINEITEM]"><ColumnGroup Usage="INEQUALITY"><Column Name="[L_SHIPDATE]" ColumnId="11"></Column></ColumnGroup><ColumnGroup Usage="INCLUDE"><Column Name="[L_SUPPKEY]" ColumnId="3"></Column><Column Name="[L_EXTENDEDPRICE]" ColumnId="6"></Column><Column Name="[L_DISCOUNT]" ColumnId="7"></Column></ColumnGroup></MissingIndex></MissingIndexGroup></MissingIndexes><MemoryGrantInfo SerialRequiredMemory="5272" SerialDesiredMemory="74416" GrantedMemory="0" MaxUsedMemory="0"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="53828" EstimatedPagesCached="40371" EstimatedAvailableDegreeOfParallelism="6" MaxCompileMemory="3861312"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-16T23:57:17.77" ModificationCount="0" SamplingPercent="100" Statistics="[IX_LINEITEM_L_ORDERKEY]" Table="[LINEITEM]" Schema="[dbo]" Database="[QD_TPCH]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-16T23:57:19.04" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000004_3F466844]" Table="[CUSTOMER]" Schema="[dbo]" Database="[QD_TPCH]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-16T23:57:17.44" ModificationCount="0" SamplingPercent="100" Statistics="[PK_ORDERS]" Table="[ORDERS]" Schema="[dbo]" Database="[QD_TPCH]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-16T23:57:17.34" ModificationCount="0" SamplingPercent="100" Statistics="[PK_NATION]" Table="[NATION]" Schema="[dbo]" Database="[QD_TPCH]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-16T23:57:17.40" ModificationCount="0" SamplingPercent="100" Statistics="[IX_CUSTOMER_C_MKTSEGMENT]" Table="[CUSTOMER]" Schema="[dbo]" Database="[QD_TPCH]"></StatisticsInfo><StatisticsI