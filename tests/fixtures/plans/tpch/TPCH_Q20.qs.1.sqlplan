<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4315.2"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT /* QD-TPCH:Q20 */&#xa;    S.S_NAME,&#xa;    S.S_ADDRESS&#xa;FROM dbo.SUPPLIER S&#xa;JOIN dbo.NATION N ON S.S_NATIONKEY = N.N_NATIONKEY&#xa;WHERE S.S_SUPPKEY IN (&#xa;    SELECT PS.PS_SUPPKEY&#xa;    FROM dbo.PARTSUPP PS&#xa;    WHERE PS.PS_PARTKEY IN (&#xa;        SELECT P.P_PARTKEY&#xa;        FROM dbo.PART P&#xa;        WHERE P.P_NAME LIKE &apos;part green%&apos;&#xa;    )&#xa;      AND PS.PS_AVAILQTY &gt; (&#xa;          SELECT 0.5 * SUM(L.L_QUANTITY)&#xa;          FROM dbo.LINEITEM L&#xa;          WHERE L.L_PARTKEY = PS.PS_PARTKEY&#xa;            AND L.L_SUPPKEY = PS.PS_SUPPKEY&#xa;            AND L.L_SHIPDATE &gt;= CAST(&apos;1994-01-01&apos; AS date)&#xa;            AND L.L_SHIPDATE &lt; DATEADD(YEAR, 1, CAST(&apos;1994-01-01&apos; AS date))&#xa;      )&#xa;)&#xa;  AND N.N_NAME = &apos;CANADA&apos;&#xa;ORDER BY S.S_NAME" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x090060E1535DF4D53B41C6EFC0B753908B660000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="false" StatementSubTreeCost="9.61438" StatementEstRows="36.8401" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x87774F6A80580ADF" QueryPlanHash="0x146276E46CA27BE1" StatementOptmEarlyAbortReason="TimeOut" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan CachedPlanSize="104" CompileTime="78" CompileCPU="78" CompileMemory="2816"><MissingIndexes><MissingIndexGroup Impact="73.2469"><MissingIndex Database="[QD_TPCH]" Schema="[dbo]" Table="[LINEITEM]"><ColumnGroup Usage="INEQUALI