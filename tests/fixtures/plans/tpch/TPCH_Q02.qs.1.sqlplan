<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4315.2"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT TOP (100) /* QD-TPCH:Q02 */&#xa;    S.S_ACCTBAL,&#xa;    S.S_NAME,&#xa;    N.N_NAME,&#xa;    P.P_PARTKEY,&#xa;    P.P_MFGR,&#xa;    S.S_ADDRESS,&#xa;    S.S_PHONE,&#xa;    S.S_COMMENT&#xa;FROM dbo.PART P&#xa;JOIN dbo.PARTSUPP PS ON P.P_PARTKEY = PS.PS_PARTKEY&#xa;JOIN dbo.SUPPLIER S ON S.S_SUPPKEY = PS.PS_SUPPKEY&#xa;JOIN dbo.NATION N ON S.S_NATIONKEY = N.N_NATIONKEY&#xa;JOIN dbo.REGION R ON N.N_REGIONKEY = R.R_REGIONKEY&#xa;WHERE P.P_SIZE = 15&#xa;  AND P.P_TYPE LIKE &apos;%STEEL&apos;&#xa;  AND R.R_NAME = &apos;EUROPE&apos;&#xa;  AND PS.PS_SUPPLYCOST = (&#xa;      SELECT MIN(PS2.PS_SUPPLYCOST)&#xa;      FROM dbo.PARTSUPP PS2&#xa;      JOIN dbo.SUPPLIER S2 ON S2.S_SUPPKEY = PS2.PS_SUPPKEY&#xa;      JOIN dbo.NATION N2 ON S2.S_NATIONKEY = N2.N_NATIONKEY&#xa;      JOIN dbo.REGION R2 ON N2.N_REGIONKEY = R2.R_REGIONKEY&#xa;      WHERE P.P_PARTKEY = PS2.PS_PARTKEY&#xa;        AND R2.R_NAME = &apos;EUROPE&apos;&#xa;  )&#xa;ORDER BY S.S_ACCTBAL DESC, N.N_NAME, S.S_NAME, P.P_PARTKEY" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x0900728A7AC6D501096ABDDAE3C4A9F4E24A0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="false" StatementSubTreeCost="1.70227" StatementEstRows="23.6397" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xFAC79EE9845B73E0" QueryPlanHash="0x15DFB5744AC8A52E" StatementOptmEarlyAbortReason="TimeOut" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan CachedPlanSize="136" CompileTime="413" CompileCPU="303" CompileMemory="1