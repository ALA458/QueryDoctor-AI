<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4315.2"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT -- QD-TPCH:Q16:&#xa;    P.P_BRAND,&#xa;    P.P_TYPE,&#xa;    P.P_SIZE,&#xa;    COUNT(DISTINCT PS.PS_SUPPKEY) AS SUPPLIER_CNT&#xa;FROM dbo.PARTSUPP PS&#xa;JOIN dbo.PART P ON P.P_PARTKEY = PS.PS_PARTKEY&#xa;WHERE P.P_BRAND &lt;&gt; &apos;Brand#45&apos;&#xa;  AND P.P_TYPE NOT LIKE &apos;MEDIUM POLISHED%&apos;&#xa;  AND P.P_SIZE IN (49, 14, 23, 45, 19, 3, 36, 9)&#xa;  AND PS.PS_SUPPKEY NOT IN (&#xa;      SELECT S.S_SUPPKEY&#xa;      FROM dbo.SUPPLIER S&#xa;      WHERE CHARINDEX(&apos;Customer&apos;, S.S_COMMENT) &gt; 0&#xa;        AND CHARINDEX(&apos;Complaints&apos;, S.S_COMMENT, CHARINDEX(&apos;Customer&apos;, S.S_COMMENT) + 8) &gt; 0&#xa;  )&#xa;GROUP BY P.P_BRAND, P.P_TYPE, P.P_SIZE&#xa;ORDER BY SUPPLIER_CNT DESC, P.P_BRAND ASC, P.P_TYPE ASC, P.P_SIZE ASC" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x0900E443340B58F047002FB9C17605E5EBA30000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="false" StatementSubTreeCost="1.74929" StatementEstRows="1766.29" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x691CB76CCE066B43" QueryPlanHash="0x2BA8E2D99CB3A280" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan CachedPlanSize="72" CompileTime="33" CompileCPU="32" CompileMemory="960"><MissingIndexes><MissingIndexGroup Impact="16.4584"><MissingIndex Database="[QD_TPCH]" Schema="[dbo]" Table="[PART]"><ColumnGroup Usage="INEQUALITY"><Column Name="[P_BRAND]" ColumnId="4"></Column><Column Name="[P_SIZE]" ColumnId="6"></Column></ColumnGroup><Column