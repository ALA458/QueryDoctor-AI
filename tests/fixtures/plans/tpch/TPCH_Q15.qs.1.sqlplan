<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4315.2"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH REVENUE0 AS (&#xa;    SELECT /* QD-TPCH:Q15 */&#xa;        L_SUPPKEY AS SUPPLIER_NO,&#xa;        SUM(L_EXTENDEDPRICE * (1 - L_DISCOUNT)) AS TOTAL_REVENUE&#xa;    FROM dbo.LINEITEM&#xa;    WHERE L_SHIPDATE &gt;= CAST(&apos;1996-01-01&apos; AS date)&#xa;      AND L_SHIPDATE &lt; DATEADD(MONTH, 3, CAST(&apos;1996-01-01&apos; AS date))&#xa;    GROUP BY L_SUPPKEY&#xa;)&#xa;SELECT&#xa;    S.S_SUPPKEY,&#xa;    S.S_NAME,&#xa;    S.S_ADDRESS,&#xa;    S.S_PHONE,&#xa;    R.TOTAL_REVENUE&#xa;FROM dbo.SUPPLIER S&#xa;JOIN REVENUE0 R ON S.S_SUPPKEY = R.SUPPLIER_NO&#xa;WHERE R.TOTAL_REVENUE = (SELECT MAX(TOTAL_REVENUE) FROM REVENUE0)&#xa;ORDER BY S.S_SUPPKEY" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x090072B0602FC7256C5C84D1353AEBAC83CF0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="false" StatementSubTreeCost="6.82832" StatementEstRows="1" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xCE3DABC862F6374F" QueryPlanHash="0x4EC5FBF97DB2AEAF" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan CachedPlanSize="64" CompileTime="13" CompileCPU="13" CompileMemory="1144"><ThreadStat Branches="3"></ThreadStat><MissingIndexes><MissingIndexGroup Impact="87.0485"><MissingIndex Database="[QD_TPCH]" Schema="[dbo]" Table="[LINEITEM]"><ColumnGroup Usage="INEQUALITY"><Column Name="[L_SHIPDATE]" ColumnId="11"></Column></ColumnGroup><ColumnGroup Usage="INCLUDE"><Column Name="[L_SUPPKEY]" ColumnId="3"></Column><Column Name="[L_EXTENDEDPRICE]" ColumnId="6"></Column><Column Name="[L_DISCOUNT]" ColumnId="7"></Column></ColumnGroup></MissingIndex></MissingIndexGroup></MissingIndexes><MemoryGrantInfo SerialRequiredMemory="1536" SerialDesiredMemory="1872" GrantedMemory="0" MaxUsedMemory="0"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="53828" EstimatedPagesCached="40371" EstimatedAvailableDegreeOfParallelism="6" MaxCompileMemory="3940824"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-16T23:19:09.92" ModificationCount="0" SamplingPercent="100" Statistics="[IX_LINEITEM_L_ORDERKEY]" Table="[LINEITEM]" Schema="[dbo]" Database="[QD_TPCH]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-16T23:19:09.37" ModificationCount="0" SamplingPercent="100" Statistics="[PK_SUPPLIER]" Table="[SUPPLIER]" Schema="[dbo]" Database="[QD_TPCH]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-16T23:19:11.77" ModificationCount="0" SamplingPercent="14.808" Statistics="[_WA_Sys_00000003_4316F928]" Table="[LINEITEM]" Schema="[dbo]" Database="[QD_TPCH]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-16T23:19:09.73" ModificationCount="0" SamplingPercent="100" Statistics="[PK_LINEITEM]" Table="[LINEITEM]" Schema="[dbo]" Database="[QD_TPCH]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-16T23:19:10.65" ModificationCount="0" SamplingPercent="14.808" Statistics="[_WA_Sys_0000000B_4316F928]" Table="[LINEITEM]" Schema="[dbo]" Database="[QD_TPCH]"></StatisticsInfo></OptimizerStatsUsage><RelOp NodeId="0" PhysicalOp="Parallelism" LogicalOp="Gather Streams" EstimateRows="1" EstimateIO="0" EstimateCPU="0.0285352" AvgRowSize="92" EstimatedTotalSubtreeCost="6.82832" Parallel="1" EstimateRebinds="0" EstimateRewinds="0" EstimatedExecutionMode="Row"><OutputList><ColumnReference Database="[QD_TPCH]" Schema="[dbo]" Table="[SUPPLIER]" Alias="[S]" Column="S_SUPPKEY"></ColumnReference><ColumnReference Database="[QD_TPCH]" Schema="[dbo]" Table="[SUPPLIER]" Alias="[S]" C