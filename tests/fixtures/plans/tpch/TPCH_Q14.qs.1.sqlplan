<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4315.2"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT /* QD-TPCH:Q14 */&#xa;    100.00 * SUM(CASE WHEN P.P_TYPE LIKE &apos;PROMO%&apos; THEN L.L_EXTENDEDPRICE * (1 - L.L_DISCOUNT) ELSE 0 END)&#xa;    / NULLIF(SUM(L.L_EXTENDEDPRICE * (1 - L.L_DISCOUNT)), 0) AS PROMO_REVENUE&#xa;FROM dbo.LINEITEM L&#xa;JOIN dbo.PART P ON L.L_PARTKEY = P.P_PARTKEY&#xa;WHERE L.L_SHIPDATE &gt;= CAST(&apos;1995-09-01&apos; AS date)&#xa;  AND L.L_SHIPDATE &lt; DATEADD(MONTH, 1, CAST(&apos;1995-09-01&apos; AS date))" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x090067EEC7A582FBCF7CD02BDF9E0DAAD3DC0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="false" StatementSubTreeCost="7.05554" StatementEstRows="1" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x7AA954D65FC576F9" QueryPlanHash="0x43ACF875F14AC9A7" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan CachedPlanSize="88" CompileTime="4" CompileCPU="4" CompileMemory="568"><ThreadStat Branches="2"></ThreadStat><MissingIndexes><MissingIndexGroup Impact="84.3869"><MissingIndex Database="[QD_TPCH]" Schema="[dbo]" Table="[LINEITEM]"><ColumnGroup Usage="INEQUALITY"><Column Name="[L_SHIPDATE]" ColumnId="11"></Column></ColumnGroup><ColumnGroup Usage="INCLUDE"><Column Name="[L_PARTKEY]" ColumnId="2"></Column><Column Name="[L_EXTENDEDPRICE]" ColumnId="6"></Column><Column Name="[L_DISCOUNT]" ColumnId="7"></Column></ColumnGroup></MissingIndex></MissingIndexGroup></MissingIndexes><MemoryGrantInfo SerialRequiredMemory="1024" SerialDesiredMemory="3088" GrantedMemory="0"