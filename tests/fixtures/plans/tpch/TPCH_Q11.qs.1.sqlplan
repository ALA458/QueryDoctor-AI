<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4315.2"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH DE_SUPP AS (&#xa;    SELECT -- QD-TPCH:Q11:&#xa;        S.S_SUPPKEY&#xa;    FROM dbo.SUPPLIER S&#xa;    JOIN dbo.NATION N ON S.S_NATIONKEY = N.N_NATIONKEY&#xa;    WHERE N.N_NAME = &apos;GERMANY&apos;&#xa;),&#xa;PART_VALUES AS (&#xa;    SELECT&#xa;        PS.PS_PARTKEY,&#xa;        SUM(PS.PS_SUPPLYCOST * PS.PS_AVAILQTY) AS VALUE_TOTAL&#xa;    FROM dbo.PARTSUPP PS&#xa;    JOIN DE_SUPP DS ON PS.PS_SUPPKEY = DS.S_SUPPKEY&#xa;    GROUP BY PS.PS_PARTKEY&#xa;)&#xa;SELECT&#xa;    PV.PS_PARTKEY,&#xa;    PV.VALUE_TOTAL&#xa;FROM PART_VALUES PV&#xa;WHERE PV.VALUE_TOTAL &gt; (&#xa;    SELECT SUM(PV2.VALUE_TOTAL) * 0.001&#xa;    FROM PART_VALUES PV2&#xa;)&#xa;ORDER BY PV.VALUE_TOTAL DESC" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x0900E190B55EA6580B5EDFE62E64F0C0849C0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="false" StatementSubTreeCost="1.86862" StatementEstRows="903.937" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x199CA7BDF834648A" QueryPlanHash="0x27B7BF3FF20D65F8" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan CachedPlanSize="112" CompileTime="7" CompileCPU="7" CompileMemory="1216"><MissingIndexes><MissingIndexGroup Impact="44.4262"><MissingIndex Database="[QD_TPCH]" Schema="[dbo]" Table="[PARTSUPP]"><ColumnGroup Usage="EQUALITY"><Column Name="[PS_SUPPKEY]" ColumnId="2"></Column></ColumnGroup><ColumnGroup Usage="INCLUDE"><Column Name="[PS_AVAILQTY]" ColumnId="3"></Column><Column Name="[PS_SUPPLYCOST]" ColumnId="4"></Column>