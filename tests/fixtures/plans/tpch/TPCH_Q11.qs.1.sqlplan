<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4315.2"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT /* QD-TPCH:Q11 */&#xa;    PS.PS_PARTKEY,&#xa;    SUM(PS.PS_SUPPLYCOST * PS.PS_AVAILQTY) AS VALUE_TOTAL&#xa;FROM dbo.PARTSUPP PS&#xa;JOIN dbo.SUPPLIER S ON PS.PS_SUPPKEY = S.S_SUPPKEY&#xa;JOIN dbo.NATION N ON S.S_NATIONKEY = N.N_NATIONKEY&#xa;WHERE N.N_NAME = &apos;GERMANY&apos;&#xa;GROUP BY PS.PS_PARTKEY&#xa;HAVING SUM(PS.PS_SUPPLYCOST * PS.PS_AVAILQTY) &gt; (&#xa;    SELECT SUM(PS2.PS_SUPPLYCOST * PS2.PS_AVAILQTY) * 0.001&#xa;    FROM dbo.PARTSUPP PS2&#xa;    JOIN dbo.SUPPLIER S2 ON PS2.PS_SUPPKEY = S2.S_SUPPKEY&#xa;    JOIN dbo.NATION N2 ON S2.S_NATIONKEY = N2.N_NATIONKEY&#xa;    WHERE N2.N_NAME = &apos;GERMANY&apos;&#xa;)&#xa;ORDER BY VALUE_TOTAL DESC" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x090018EB364602552E84105054E4DBB630070000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="false" StatementSubTreeCost="1.79582" StatementEstRows="903.937" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xE828F7C66D07B197" QueryPlanHash="0xB86898846D86C462" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan CachedPlanSize="104" CompileTime="10" CompileCPU="10" CompileMemory="1200"><MissingIndexes><MissingIndexGroup Impact="46.2272"><MissingIndex Database="[QD_TPCH]" Schema="[dbo]" Table="[PARTSUPP]"><ColumnGroup Usage="EQUALITY"><Column Name="[PS_SUPPKEY]" ColumnId="2"></Column></ColumnGroup><ColumnGroup Usage="INCLUDE"><Column Name="[PS_AVAILQTY]" ColumnId="3"></Column><Column Name="[PS_SUPPLYCOST]" ColumnId="4"></Column></ColumnGroup></