<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- S1-09: pruebas contra PostgreSQL real con Testcontainers (D6). Necesitan Docker; corren en CI (ubuntu-latest). -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- S1-11: los mismos dobles de lectura de Query Store que las pruebas unitarias, sin copiarlos. -->
  <ItemGroup>
    <Compile Include="..\QueryDoctor.UnitTests\Ingestion\IngestionTestDoubles.cs" Link="Doubles\IngestionTestDoubles.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\QueryDoctor.Infrastructure\QueryDoctor.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\QueryDoctor.Api\QueryDoctor.Api.csproj" />
  </ItemGroup>

</Project>
